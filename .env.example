# --- The plan's variables ----------------------------------------------------------------
ANTHROPIC_API_KEY=              # best quality, tried first when set: https://console.anthropic.com
TAVILY_API_KEY=                 # web search (required). Free tier: 1,000 credits/month: https://app.tavily.com
MODEL=claude-sonnet-5-5         # the Anthropic model (ANTHROPIC_MODEL also works)
PORT=3000

# --- Free-tier fallbacks: set at least one model key in total ---------------------------
# Tried in order after Anthropic; when a model is rate-limited or down the next one answers.
GOOGLE_GENERATIVE_AI_API_KEY=   # free: https://aistudio.google.com/apikey
GROQ_API_KEY=                   # free: https://console.groq.com/keys
OPENROUTER_API_KEY=             # free models: https://openrouter.ai/keys

# --- Optional ----------------------------------------------------------------------------
LLM_ORDER=anthropic,groq,google,openrouter   # fastest first; reorder or drop providers
GEMINI_MODEL=gemini-3.5-flash,gemini-3.6-flash,gemini-3.1-flash-lite,gemini-2.5-flash-lite   # comma list: free quotas are per model
GROQ_MODEL=openai/gpt-oss-120b,openai/gpt-oss-20b
OPENROUTER_MODEL=google/gemma-4-31b-it:free,nvidia/nemotron-3-ultra-550b-a55b:free
MEMORY_SCOPE=global             # "global": new chats can recall old ones. "session": each chat sees only itself
DB_PATH=./data/minimi.db
DEFAULT_TZ=                     # IANA zone when the client sends none (default: server zone)
