# Required
ANTHROPIC_API_KEY=      # https://console.anthropic.com
TAVILY_API_KEY=         # https://app.tavily.com (free tier: 1,000 credits/month)

# Optional
MODEL=claude-sonnet-5-5 # any Anthropic model id; claude-haiku-5-5 is faster, a bit less careful
PORT=3000
JUDGE_MODEL=            # evals only: model for the LLM judge (default: MODEL)
DB_PATH=./data/minimi.db
DEFAULT_TZ=             # IANA zone used when the client sends none (default: server zone)
