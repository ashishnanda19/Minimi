# Search (required). Free tier: 1,000 credits/month, no card. https://app.tavily.com
TAVILY_API_KEY=

# Model providers: set AT LEAST ONE. They are tried in the order below; if one is rate-limited,
# down or rejects the request, the next one answers. All three of the first group are free.
GOOGLE_GENERATIVE_AI_API_KEY=   # free: https://aistudio.google.com/apikey
GROQ_API_KEY=                   # free: https://console.groq.com/keys
OPENROUTER_API_KEY=             # free models: https://openrouter.ai/keys
ANTHROPIC_API_KEY=              # paid, best quality (tried first when set): https://console.anthropic.com

# Optional
LLM_ORDER=anthropic,google,groq,openrouter   # reorder or drop providers
ANTHROPIC_MODEL=claude-sonnet-5-5
GEMINI_MODEL=gemini-2.5-flash
GROQ_MODEL=openai/gpt-oss-120b
OPENROUTER_MODEL=google/gemma-4-31b-it:free             # pinned free model with tool support
PORT=3000
DB_PATH=./data/minimi.db
DEFAULT_TZ=                                  # IANA zone when the client sends none (default: server zone)
